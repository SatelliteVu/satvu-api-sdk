{#- Overrides openapi-python-client's str_enum template, which emits `StrEnum`.
    StrEnum is 3.11+, and the published SDK supports Python 3.10 (see requires-python),
    so subclass `(str, Enum)` instead — equivalent for our purposes on every version. -#}
from enum import Enum

class {{ enum.class_info.name }}(str, Enum):
    {% for key, value in enum.values|dictsort(true) %}
    {{ key }} = "{{ value }}"
    {% endfor %}

    def __str__(self) -> str:
        return str(self.value)
