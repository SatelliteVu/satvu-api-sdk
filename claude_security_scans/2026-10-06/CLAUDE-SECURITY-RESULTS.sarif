                    "text": "            url=f\"/{contract_id}/collections/{collection_id}/{item_id}\","
                  }
                }
              },
              "logicalLocations": [
                {
                  "name": "CatalogService.get_item",
                  "fullyQualifiedName": "CatalogService.get_item"
                }
              ]
            }
          ],
          "properties": {
            "claudeSecurityPlugin": {
