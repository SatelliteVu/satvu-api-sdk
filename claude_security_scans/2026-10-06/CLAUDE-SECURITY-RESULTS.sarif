                  "snippet": {
                    "text": "            url=f\"/{contract_id}/{order_id}/{item_id}/download\","
                  }
                }
              },
              "logicalLocations": [
                {
                  "name": "CosService.download_order_item_to_file",
                  "fullyQualifiedName": "CosService.download_order_item_to_file"
                }
              ]
            }
          ],
          "properties": {
            "claudeSecurityPlugin": {
              "id": "F5",
