                  "snippet": {
                    "text": "            url=f\"/webhooks/{id}/rotate\","
                  }
                }
              },
              "logicalLocations": [
                {
                  "name": "IdService.rotate_webhook_signing_key",
                  "fullyQualifiedName": "IdService.rotate_webhook_signing_key"
                }
              ]
            }
          ],
          "properties": {
