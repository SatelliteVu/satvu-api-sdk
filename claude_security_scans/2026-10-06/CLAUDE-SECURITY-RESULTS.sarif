                  "snippet": {
                    "text": "            url=f\"/{contract_id}/{order_id}/{item_id}/download\","
                  }
                }
              },
              "logicalLocations": [
                {
                  "name": "CosService.download_order_item",
                  "fullyQualifiedName": "CosService.download_order_item"
                }
              ]
            }
          ],
